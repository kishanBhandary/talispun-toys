---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getFilteredGames } from '../lib/games';
import { getAllCategories } from '../lib/categories';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const selectedCategoryIds = Astro.url.searchParams
  .getAll('category')
  .map(Number)
  .filter((id) => Number.isInteger(id) && id > 0);
const selectedPublisherValue = Astro.url.searchParams.get('publisher');
const parsedPublisherId = selectedPublisherValue ? Number(selectedPublisherValue) : undefined;
const selectedPublisherId =
  parsedPublisherId !== undefined && Number.isInteger(parsedPublisherId) && parsedPublisherId > 0
    ? parsedPublisherId
    : undefined;
const [games, categories, publishers] = await Promise.all([
  getFilteredGames(db, { categoryIds: selectedCategoryIds, publisherId: selectedPublisherId }),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <form method="get" class="mb-10 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
      <div class="flex flex-col gap-6 md:flex-row md:items-end">
        <fieldset class="flex-1">
          <legend class="mb-3 text-lg font-semibold text-slate-100">Filter by category</legend>
          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2" data-testid="category-filters">
            {categories.map((category) => (
              <label class="flex items-center gap-2 text-slate-300 focus-within:text-slate-100">
                <input
                  type="checkbox"
                  name="category"
                  value={category.id}
                  checked={selectedCategoryIds.includes(category.id)}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                  data-testid={`category-filter-${category.id}`}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="flex-1">
          <label for="publisher-filter" class="mb-3 block text-lg font-semibold text-slate-100">
            Filter by publisher
          </label>
          <select
            id="publisher-filter"
            name="publisher"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.id} selected={selectedPublisherId === publisher.id}>
                {publisher.name}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <button
          type="submit"
          class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="apply-filters"
        >
          Apply filters
        </button>
        <a
          href="/"
          class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="clear-filters"
        >
          Clear filters
        </a>
      </div>
    </form>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      {games.length > 0 && (
        <div
          class="hidden text-center rounded-xl border border-slate-700 bg-slate-800/50 py-12"
          data-testid="filtered-empty-state"
          aria-live="polite"
        >
          <p class="text-slate-300">No games match the selected filters.</p>
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search);
  const categoryIds = params.getAll('category');
  const publisherId = params.get('publisher');
  const cards = document.querySelectorAll<HTMLElement>('[data-testid="game-card"]');
  const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const filteredEmptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  let visibleCards = 0;

  cards.forEach((card) => {
    const categoryMatches =
      categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '');
    const publisherMatches =
      publisherId === null ||
      publisherId === '' ||
      card.dataset.publisherId === publisherId;
    const isVisible = categoryMatches && publisherMatches;

    card.hidden = !isVisible;
    if (isVisible) {
      visibleCards += 1;
    }
  });

  if (gamesGrid && filteredEmptyState) {
    gamesGrid.hidden = visibleCards === 0;
    filteredEmptyState.hidden = visibleCards !== 0;
  }
</script>
